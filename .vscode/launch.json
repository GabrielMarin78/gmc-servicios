{
  // Abre Chrome en el servidor local. Live Server (extensión de VS Code) usa el puerto 5500 por defecto.
  // Inicie primero Live Server ("Go Live") o ejecute: python -m http.server 5500
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Iniciar Chrome para localhost",
      "url": "http://localhost:5500",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
